{
  "name": "paysapro-site",
  "private": true,
  "version": "1.0.0",
  "description": "Site commercial officiel de Paysapro AI — du chantier au devis, en quelques minutes.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/postbuild.mjs",
    "preview": "vite preview --host",
    "preview:pages": "vite preview --base /paysapro-site/",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check:secrets": "node scripts/check-secrets.mjs",
    "images": "node scripts/generate-images.mjs",
    "favicons": "node scripts/favicons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}

# ─────────────────────────────────────────────────────────────
# Variables PUBLIQUES du site marketing Paysapro AI.
# Tout ce qui commence par VITE_ est intégré au JavaScript envoyé
# au navigateur : n'y mettez JAMAIS de clé secrète (Stripe secret,
# Supabase service role, clé Resend/Brevo…).
# Copiez ce fichier en .env.local pour le développement.
# ─────────────────────────────────────────────────────────────

# Sous-dossier de publication : / (domaine, Vercel) ou /paysapro-site/ (GitHub Pages)
VITE_BASE_PATH=/

# Adresse publique du site marketing (canonical, sitemap, OpenGraph)
VITE_SITE_URL=https://www.paysapro.ai

# Application SaaS (séparée du site)
VITE_APP_URL=https://app.paysapro.ai
# Chemin ajouté à VITE_APP_URL pour l'inscription et la connexion (vide = page d'accueil de l'app)
VITE_APP_SIGNUP_PATH=
VITE_APP_LOGIN_PATH=

# Google Search Console : code de la balise de vérification (partie content="…"). Public.
VITE_GOOGLE_SITE_VERIFICATION=

# Coordonnées publiques (laisser vide tant qu'elles n'existent pas : rien n'est affiché)
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=

# Formulaires → table Supabase site_messages (voir supabase/site_messages.sql). Clé PUBLIQUE uniquement.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Formulaires (autre option) : URL d'une fonction serveur (Vercel, Supabase Edge…) qui détient la clé Resend/Brevo.
# Vide = MockLeadProvider (rien n'est envoyé, un message l'indique clairement).
VITE_LEAD_ENDPOINT=

# Mesure d'audience : none | console | plausible  (plausible = sans cookie)
VITE_ANALYTICS_PROVIDER=none
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# Bouton « Demander une démonstration » (true / false)
VITE_ENABLE_DEMO_CTA=false

# Vidéo de démonstration (fichier .mp4 ou URL d'intégration YouTube/Vimeo). Vide = placeholder.
VITE_DEMO_VIDEO_URL=
